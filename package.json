{
  "name": "mentorai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first web tutor for grades 6–8, covering math and ELA.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "dexie": "^4.4.2"
  }
}
